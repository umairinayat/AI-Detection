# AI Text Detection API - Environment Variables
# Copy this file to .env and configure your settings

# === API Configuration ===
# Your API keys (generate secure random keys)
API_KEY_1=aidet_your-secret-api-key-here-replace-this
# API_KEY_2=aidet_another-key-if-needed

# Server configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# === Classifier / Hugging Face (read-only — does not upload or change the Hub) ===
# Pin a Hub commit for PEFT adapters (e.g. undo a bad local training):
# HF_MODEL_REVISION=2a4d394b116103f881ac291ebf1c15f33e50289d
# HF_MODEL_REPO=umairinayat/llm_detector
# If you still have models/detector/llm_detector/best locally but want Hub instead:
# HF_USE_HUB_LLM=1
# Or force a specific path / repo id:
# CLASSIFIER_PATH=umairinayat/llm_detector
# HF_TOKEN=hf_...   # optional for private repos; public models can load without it

# === Optional: Advanced Settings ===
# MAX_FILE_SIZE_MB=10
# MAX_BATCH_SIZE=10
